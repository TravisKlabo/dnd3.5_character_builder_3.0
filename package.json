{
  "name": "dnd35-character-builder-3.0",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && electron .",
    "build": "tsc -b && tsc -p tsconfig.test.json && vite build && node scripts/check-build.mjs",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build",
    "benchmark": "node scripts/benchmark.mjs",
    "preview": "vite preview",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:windows": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^39.1.2",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.dnd35.characterbuilder30",
    "productName": "D&D 3.5 Character Builder 3.0",
    "asar": true,
    "files": [
      "dist/**/*",
      "desktop/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "DND35-Character-Builder-3.0-${version}.${ext}"
    }
  }
}
